# Stripe Secret Key (required) – from Stripe Dashboard > Developers > API keys
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# Client URL for Stripe success/cancel redirects
CLIENT_URL=http://localhost:5173

# Port for the Express server (default: 3001)
PORT=3001

# Summer Camp Stripe Price IDs (server-side mapping)
STRIPE_CAMP_CAD_PRICE_ID=price_xxx
STRIPE_CAMP_PROGRAMMING_PRICE_ID=price_xxx
STRIPE_CAMP_ENGINEERING1_PRICE_ID=price_xxx
STRIPE_CAMP_ENGINEERING2_PRICE_ID=price_xxx
STRIPE_ADDON_WL_PRICE_ID=price_xxx
