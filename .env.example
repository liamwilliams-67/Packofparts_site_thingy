# Copy to .env and set your Stripe Payment Link.
# Create a link in Stripe Dashboard: Products → Payment links → create link.

VITE_STRIPE_PAYMENT_LINK=https://buy.stripe.com/xxxxx

# Stripe Buy Button – set in Stripe Dashboard → Payment links → Buy Button
VITE_STRIPE_BUY_BUTTON_ID=buy_btn_xxxxxxxxxxxxxxxxxxxxxxxx
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxx
