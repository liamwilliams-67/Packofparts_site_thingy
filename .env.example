# Stripe Configuration (for Codespaces / local development)
# In production these are injected via GitHub Secrets in deploy.yml

VITE_STRIPE_BUY_BUTTON_ID="buy_btn_xxx"
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_xxx"
VITE_STRIPE_PAYMENT_LINK=https://buy.stripe.com/test_xxx

# Mapbox – public access token for the contact page map
VITE_MAPBOX_TOKEN="pk.xxx"

# Summer Camp Products – Stripe Price IDs for Checkout Sessions
VITE_STRIPE_CAMP_CAD_PRICE_ID="price_xxx"
VITE_STRIPE_CAMP_PROGRAMMING_PRICE_ID="price_xxx"
VITE_STRIPE_CAMP_ENGINEERING1_PRICE_ID="price_xxx"
VITE_STRIPE_CAMP_ENGINEERING2_PRICE_ID="price_xxx"
VITE_STRIPE_ADDON_WL_PRICE_ID="price_xxx"

# Backend API URL for Stripe Checkout Sessions
# Leave empty for local/Codespaces dev (Vite proxy forwards to localhost:3001).
# Set to the full backend URL only for production builds.
VITE_API_URL=
